# ==============================================================================
# INTELLOOP AI RESEARCH PLATFORM — ENVIRONMENT CONFIGURATION
# Copy this file to .env and configure any optional external API credentials.
# ==============================================================================

# TOOL 1: Tavily Search API (Optional - enhances real-time web research)
# Get a free API key at: https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TOOL 2: arXiv Academic Search API
# No API key required! arXiv is a public, open-access academic repository.

# Additional Search Providers (Optional fallback)
# SERPER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SEARCH_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM Providers (Optional - for external generative foundation models)
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server Port (Default: 3000)
PORT=3000
